# ─── EpochBridge Configuration ───────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Kafka CDC Streaming
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=epochbridge-gateway
KAFKA_GROUP_ID=epochbridge-cdc-group
KAFKA_CDC_TOPIC=legacy.cdc.changes

# Legacy Database (SQLite mock — replace with real connection in production)
LEGACY_DB_PATH=./data/legacy.db

# LLM Intelligence Layer
# Supports: openai, local, mock
LLM_PROVIDER=mock
OPENAI_API_KEY=sk