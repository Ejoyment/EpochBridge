{
  "name": "epochbridge",
  "version": "1.0.0",
  "description": "Intelligent middleware & legacy modernization hub — wraps legacy databases in modern GraphQL APIs using CDC streaming and LLM-assisted schema generation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:portal": "cd portal && npm run dev",
    "test": "jest --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "seed": "ts-node src/legacy-db/seed.ts",
    "generate-schema": "ts-node src/intelligence/generate.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "legacy",
    "modernization",
    "graphql",
    "federation",
    "cdc",
    "kafka",
    "mainframe",
    "middleware"
  ],
  "author": "EpochBridge Founding Team",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@apollo/gateway": "^2.9.0",
    "@apollo/server": "^4.11.0",
    "@apollo/subgraph": "^2.9.0",
    "@graphql-tools/schema": "^10.0.0",
    "@graphql-tools/utils": "^10.0.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "graphql": "^16.9.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^5.16.0",
    "kafkajs": "^2.2.4",
    "express-rate-limit": "^7.4.0",
    "ws": "^8.18.0",
    "winston": "^3.14.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
